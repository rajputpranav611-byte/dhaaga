{
  "name": "dhaaga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "seed": "tsx server/seed.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.6",
    "@fontsource/instrument-sans": "^5.2.6",
    "@fontsource/noto-sans-devanagari": "^5.2.6",
    "@fontsource/noto-sans-gujarati": "^5.2.6",
    "@google/genai": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.1",
    "multer": "^2.0.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.1.0"
  }
}
